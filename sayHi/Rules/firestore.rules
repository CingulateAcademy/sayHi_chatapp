rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }


    match /users/{userId} {
      allow read: if isSignedIn();

      allow create: if isOwner(userId)
                    && request.resource.data.keys().hasOnly([
                         'displayName', 'photoURL', 'email',
                         'lastSeen', 'fcmTokens', 'createdAt', 'bio'
                       ]);

      // Only the fields being changed must be in the allow-list
      allow update: if isOwner(userId)
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly([
                           'displayName', 'photoURL', 'email',
                           'lastSeen', 'fcmTokens', 'bio'
                         ]);

      allow delete: if isOwner(userId);
    }

    match /conversations/{conversationId} {

      allow read: if isSignedIn()
                  && request.auth.uid in resource.data.participants;

      allow create: if isSignedIn()
                    && request.auth.uid in request.resource.data.participants
                    && request.resource.data.participants.size() == 2;

      // Participants may update metadata, but never the participants array
      allow update: if isSignedIn()
                    && request.auth.uid in resource.data.participants
                    && !('participants' in request.resource.data
                           .diff(resource.data).affectedKeys());

      allow delete: if isSignedIn()
                    && request.auth.uid in resource.data.participants;

      
      match /messages/{messageId} {

        allow read: if isSignedIn()
                    && request.auth.uid in
                         get(/databases/$(database)/documents/conversations/$(conversationId))
                           .data.participants;

        allow create: if isSignedIn()
                      && request.auth.uid in
                           get(/databases/$(database)/documents/conversations/$(conversationId))
                             .data.participants
                      && request.resource.data.senderId == request.auth.uid
                      && request.resource.data.keys().hasAll(['senderId', 'createdAt', 'type'])
                      && request.resource.data.type in ['text', 'image'];

        allow update: if isSignedIn()
                      && request.auth.uid in
                           get(/databases/$(database)/documents/conversations/$(conversationId))
                             .data.participants
                      && request.resource.data.senderId == resource.data.senderId
                      && request.resource.data.createdAt == resource.data.createdAt;

        allow delete: if isSignedIn()
                      && request.auth.uid in
                           get(/databases/$(database)/documents/conversations/$(conversationId))
                             .data.participants
                      && resource.data.senderId == request.auth.uid;
      }
    }


    match /userConversations/{userId}/conversations/{conversationId} {
      allow read, write: if isOwner(userId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
