rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helpers

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isParticipant(conversationId) {
      return isSignedIn() &&
             request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
    }

     // We only allow specific fields when creating/updating a user
  
    function isValidUser() {
      let allowed = ['displayName', 'photoURL', 'email', 'lastSeen', 'fcmTokens', 'createdAt', 'bio'];
      return request.resource.data.keys().hasOnly(allowed);
    }


    match /users/{userId} {
       // Anyone signed in can read a public profile
      
      allow read: if isSignedIn();

       // Only the owner can create/update their own document

     
      allow create: if isOwner(userId) && isValidUser();
      allow update: if isOwner(userId) && isValidUser();

      
      allow delete: if isOwner(userId);
    }

    
    match /conversations/{conversationId} {
      // Only participants can read the conversation
      
      allow read: if isParticipant(conversationId);

      
      allow create: if isSignedIn()
                    && request.auth.uid in request.resource.data.participants
                    && request.resource.data.participants.size() == 2;

     
      allow update: if isParticipant(conversationId)
                    && !request.resource.data.diff(resource.data).affectedKeys()
                         .hasAny(['participants']);

      
      allow delete: if isParticipant(conversationId);

    
      match /messages/{messageId} {
           // Only participants of the parent conversation can read messages
        
        allow read: if isParticipant(conversationId);

        
        allow create: if isParticipant(conversationId)
                      && request.resource.data.senderId == request.auth.uid
                      && request.resource.data.keys().hasAll(['senderId', 'createdAt', 'type'])
                      && request.resource.data.type in ['text', 'image'];

        
        allow update: if isParticipant(conversationId)
                      && request.resource.data.senderId == resource.data.senderId
                      && request.resource.data.createdAt == resource.data.createdAt;

  
        allow delete: if isParticipant(conversationId)
                      && resource.data.senderId == request.auth.uid;
      }
    }


    match /userConversations/{userId}/conversations/{conversationId} {
      
      allow read, write: if isOwner(userId);
    }

    
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

